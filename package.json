{
  "name": "mcp-trellis",
  "version": "1.1.0",
  "description": "Build secure remote MCP servers for Claude, ChatGPT and Gemini using your existing auth.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir1824/mcp-trellis.git"
  },
  "bugs": {
    "url": "https://github.com/amir1824/mcp-trellis/issues"
  },
  "homepage": "https://github.com/amir1824/mcp-trellis#readme",
  "keywords": [
    "mcp",
    "oauth",
    "oauth2.1",
    "json-rpc",
    "claude",
    "gemini",
    "codex",
    "chatgpt",
    "model-context-protocol",
    "cloudflare-workers",
    "authorization-server",
    "connector",
    "typescript",
    "mcp-server"
  ],
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./oauth": {
      "types": "./dist/oauth/router.d.ts",
      "import": "./dist/oauth/router.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    }
  },
  "files": [
    "dist",
    "docs/*.md",
    "docs/diagrams/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/oauth/*.test.ts test/mcp/*.test.ts test/adapters/*.test.ts test/auth/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --enable-source-maps test/oauth/*.test.ts test/mcp/*.test.ts test/adapters/*.test.ts test/auth/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "prepublishOnly": "npm run build && npm test",
    "demo": "npm run build && tsx examples/saas-demo/server.ts",
    "smoke:pack": "node scripts/clean-npm-smoke.mjs",
    "pretypecheck": "npm run build",
    "pretest:e2e": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
