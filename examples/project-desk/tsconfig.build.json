{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["server.ts", "src/**/*.ts"],
  "exclude": ["worker.ts", "dist", "node_modules"]
}
